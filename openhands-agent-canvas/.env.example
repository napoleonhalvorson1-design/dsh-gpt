# Configure these as secret runtime variables in Sites; never commit actual values.
CANVAS_ACCESS_PASSWORD=
CANVAS_SESSION_SECRET=
# Optional administrator-managed OpenHands default backend.
OPENHANDS_MODE=remote
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=
OPENHANDS_MODEL=acp:codex
OPENHANDS_WORKSPACE=/srv/openhands-workspaces
OPENHANDS_LLM_API_KEY=
OPENHANDS_LLM_BASE_URL=
OPENHANDS_ACP_MODEL=gpt-5.6-sol
OPENHANDS_CODEX_ACP_COMMAND=/opt/openhands-agent/acp/node_modules/.bin/codex-acp
# Sites -> durable controller (key is secret)
CANVAS_CONTROL_URL=
CANVAS_CONTROL_API_KEY=
# Controller-only, kept in root-readable EnvironmentFile, never in Sites/browser.
CANVAS_DATABASE_PATH=/srv/openhands/control/canvas.sqlite
CANVAS_CONTROL_ENCRYPTION_KEY=
CANVAS_CONTROL_PORT=18110
# S3 can use encrypted website settings or controller-only environment variables.
# Local/private deployments may explicitly allow HTTP S3; HTTPS is the default.
CANVAS_S3_ALLOW_HTTP=false

# Direct web gateway only (root-owned web.env)
CANVAS_PUBLIC_ORIGIN=https://canvas.43-173-109-57.sslip.io
CANVAS_WEB_PORT=18120

# Controller-only private registry, example: config/ai-profiles.example.json
CANVAS_AI_PROFILES_PATH=/etc/openhands-control/ai-profiles.json

# Qicai Cloud, controller-only. Real keys belong in /etc/openhands-control/s3.env (0600).
CANVAS_S3_ENDPOINT=https://s3.7caiyun.com
CANVAS_S3_REGION=us-west
CANVAS_S3_BUCKET=zzx123-u1aya4fk
CANVAS_S3_ACCESS_KEY_ID=
CANVAS_S3_SECRET_ACCESS_KEY=
CANVAS_S3_FORCE_PATH_STYLE=false
# First connection: read-only listing. Set false after authorizing collaboration data sync.
CANVAS_S3_READ_ONLY=true
